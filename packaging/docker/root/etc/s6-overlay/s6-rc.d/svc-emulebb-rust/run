#!/usr/bin/with-contenv bash
set -euo pipefail

mkdir -p /config /data/incoming /data/temp
if [[ -z ${LSIO_NON_ROOT_USER:-} ]]; then
    chown abc:abc /config /data/incoming /data/temp
    s6-setuidgid abc /usr/lib/emulebb-rust/emulebb-profile-init
    exec s6-setuidgid abc /usr/lib/emulebb-rust/emulebb-rust --profile /config/emulebb-rust
fi
/usr/lib/emulebb-rust/emulebb-profile-init
exec /usr/lib/emulebb-rust/emulebb-rust --profile /config/emulebb-rust
