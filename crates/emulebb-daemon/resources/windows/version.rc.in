LANGUAGE 0x09, 0x01

1 ICON "application.ico"

1 VERSIONINFO
FILEVERSION {fixed_version}
PRODUCTVERSION {fixed_version}
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x00040004L
FILETYPE 0x00000001L
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "eMuleBB Project\0"
            VALUE "Comments", "{channel}; {architecture}; {source_revision}\0"
            VALUE "FileDescription", "{description}\0"
            VALUE "FileVersion", "{version}\0"
            VALUE "LegalCopyright", "Copyright (C) eMuleBB contributors\0"
            VALUE "OriginalFilename", "{binary}.exe\0"
            VALUE "ProductName", "{product}\0"
            VALUE "ProductVersion", "{version}\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
